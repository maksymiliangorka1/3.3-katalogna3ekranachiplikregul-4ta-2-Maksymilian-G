<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="450"
             x:Class="katalog.ListScreen">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="Katalog zbioru" FontSize="22" FontWeight="Bold" />

        <ListBox Name="ItemsListBox" Height="220" />

        <TextBlock Name="StatusText" Foreground="Crimson" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Name="DetailsButton" Content="Szczegóły" Click="OnDetailsClick" />
            <Button Name="AddButton" Content="Dodaj nową pozycję" Click="OnAddClick" />
        </StackPanel>

    </StackPanel>
</UserControl>
