<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="450"
             x:Class="katalog.DetailsScreen">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="Szczegóły pozycji" FontSize="22" FontWeight="Bold" />

        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Tytuł:" FontWeight="SemiBold" Width="80" />
                <TextBlock Name="TitleText" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Rok:" FontWeight="SemiBold" Width="80" />
                <TextBlock Name="YearText" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Ocena:" FontWeight="SemiBold" Width="80" />
                <TextBlock Name="RatingText" />
            </StackPanel>
        </StackPanel>

        <Button Name="BackButton" Content="Powrót do listy" Click="OnBackClick" Width="140" />
    </StackPanel>
</UserControl>
