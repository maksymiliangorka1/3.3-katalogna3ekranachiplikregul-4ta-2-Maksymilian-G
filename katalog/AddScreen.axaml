<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="450"
             x:Class="katalog.AddScreen">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Dodaj nową pozycję" FontSize="22" FontWeight="Bold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Tytuł:" FontWeight="SemiBold" />
            <TextBox Name="TitleBox" PlaceholderText="np. Solaris" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Rok:" FontWeight="SemiBold" />
            <TextBox Name="YearBox" PlaceholderText="np. 2021" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Ocena (1-10):" FontWeight="SemiBold" />
            <TextBox Name="RatingBox" PlaceholderText="np. 9" />
        </StackPanel>

        <TextBlock Name="ValidationText" Foreground="Crimson" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Name="SaveButton" Content="Zapisz" Click="OnSaveClick" Width="100" />
            <Button Name="BackButton" Content="Powrót do listy" Click="OnBackClick" Width="140" />
        </StackPanel>
    </StackPanel>
</UserControl>
